{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/NumNum/",
  "name": "For My Num Num",
  "short_name": "Num Num",
  "description": "A little world of love, made just for you.",
  "start_url": "/NumNum/",
  "scope": "/NumNum/",
  "display": "standalone",
  "background_color": "#f8f6f4",
  "theme_color": "#8f4058",
  "icons": [
    {
      "src": "/NumNum/assets/notifications/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/NumNum/assets/notifications/notification-icon.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/NumNum/assets/notifications/app-icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/NumNum/assets/notifications/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/NumNum/assets/notifications/app-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/NumNum/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
